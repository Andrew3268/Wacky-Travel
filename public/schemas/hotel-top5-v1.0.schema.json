{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bestayable.com/schemas/hotel-top5-v1.0.schema.json",
  "title": "Be Stayable 여행 스타일별 호텔 추천 TOP 5 JSON v1.0",
  "description": "Phase 2 에디토리얼 + Analysis 상세 페이지를 위한 JSON 데이터 계약. 운영 API 연동은 Phase 5~7에서 진행.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentType",
    "slug",
    "destination",
    "recommendationCategory",
    "seo",
    "article",
    "selectionCriteria",
    "locationComparison",
    "hotels",
    "comparison",
    "recommendationsByStyle",
    "bookingTips",
    "finalVerdict",
    "research"
  ],
  "properties": {
    "schemaVersion": {
      "const": "hotel-top5-v1.0"
    },
    "contentType": {
      "const": "top5_series"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "영문 소문자·숫자·하이픈으로 구성된 식별자",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "destination": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "영문 소문자·숫자·하이픈으로 구성된 식별자",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "nameKo": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "도시/지역"
        }
      },
      "additionalProperties": false,
      "required": [
        "slug",
        "nameKo"
      ]
    },
    "recommendationCategory": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "영문 소문자·숫자·하이픈으로 구성된 식별자",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "additionalProperties": false,
      "required": [
        "slug"
      ],
      "description": "관리자 recommendation_category_slug와 일치해야 함"
    },
    "seo": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 10,
          "maxLength": 220,
          "description": "검색 결과용 제목"
        },
        "description": {
          "type": "string",
          "minLength": 35,
          "maxLength": 500,
          "description": "검색 설명"
        },
        "focusKeyword": {
          "type": "string",
          "minLength": 2,
          "maxLength": 130,
          "description": "집중 키워드"
        },
        "longtailKeywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "description": "보조 키워드"
          },
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "description"
      ]
    },
    "article": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 10,
          "maxLength": 220,
          "description": "본문 H1"
        },
        "subtitle": {
          "type": "string",
          "minLength": 5,
          "maxLength": 250,
          "description": "H1 아래 한 줄 설명"
        },
        "intro": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 30,
            "maxLength": 1400,
            "description": "평범한 대화가 아니라 여행 매거진처럼 자연스럽게 작성하는 본문 문단"
          },
          "minItems": 1,
          "maxItems": 4
        },
        "featuredImage": {
          "$ref": "#/$defs/image"
        },
        "orderMeaning": {
          "const": "curated",
          "description": "정량 순위가 아닌 에디터가 고른 5개 추천 후보"
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "intro",
        "orderMeaning"
      ]
    },
    "selectionCriteria": {
      "type": "object",
      "properties": {
        "intro": {
          "type": "string",
          "minLength": 15,
          "maxLength": 1000,
          "description": "선정 방법 설명"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/criterion"
          },
          "minItems": 2,
          "maxItems": 6
        }
      },
      "additionalProperties": false,
      "required": [
        "intro",
        "items"
      ]
    },
    "locationComparison": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "intro": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500,
          "description": "지도 안내"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    },
    "hotels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hotelEntry"
      },
      "minItems": 5,
      "maxItems": 5,
      "description": "정확히 다섯 개, id·호텔 이름 중복은 별도의 의미 검증 필요"
    },
    "comparison": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "hotel",
              "area",
              "transport",
              "grade",
              "rating",
              "bestFor",
              "strength",
              "consideration"
            ]
          },
          "minItems": 2,
          "maxItems": 7,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "columns"
      ],
      "description": "비교표 값은 hotels 데이터에서 파생. 중복 작성 금지"
    },
    "recommendationsByStyle": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/styleRecommendation"
      },
      "minItems": 1,
      "maxItems": 8
    },
    "bookingTips": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bookingTip"
      },
      "minItems": 2,
      "maxItems": 7
    },
    "finalVerdict": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200,
          "description": "최종 결론 제목"
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 30,
            "maxLength": 1400,
            "description": "평범한 대화가 아니라 여행 매거진처럼 자연스럽게 작성하는 본문 문단"
          },
          "minItems": 1,
          "maxItems": 3
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "paragraphs"
      ]
    },
    "faq": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/faqItem"
      },
      "minItems": 0,
      "maxItems": 8
    },
    "relatedContent": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relatedLink"
      },
      "minItems": 0,
      "maxItems": 8
    },
    "research": {
      "type": "object",
      "properties": {
        "lastCheckedAt": {
          "type": "string",
          "format": "date",
          "description": "정보를 확인한 날짜(YYYY-MM-DD)"
        },
        "method": {
          "type": "string",
          "minLength": 15,
          "maxLength": 1000,
          "description": "조사 방식 설명"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 0,
          "maxItems": 35
        }
      },
      "additionalProperties": false,
      "required": [
        "lastCheckedAt",
        "method",
        "sources"
      ]
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$",
          "format": "uri",
          "description": "실제 웹사이트의 절대 URL"
        },
        "alt": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "description": "사진에 보이는 내용을 정확히 설명"
        },
        "credit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "저작권/제공처"
        },
        "creditUrl": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$",
          "format": "uri",
          "description": "실제 웹사이트의 절대 URL"
        }
      },
      "additionalProperties": false,
      "required": [
        "src",
        "alt"
      ],
      "description": "실제 사용 권한과 원본 출처를 확인한 이미지"
    },
    "coords": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "additionalProperties": false,
      "required": [
        "lat",
        "lng"
      ]
    },
    "travel": {
      "type": "object",
      "properties": {
        "walkMinutes": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "driveMinutes": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "route",
            "estimated"
          ]
        },
        "checkedAt": {
          "type": "string",
          "format": "date",
          "description": "정보를 확인한 날짜(YYYY-MM-DD)"
        }
      },
      "additionalProperties": false,
      "required": [
        "sourceType"
      ],
      "description": "실제 경로(route) 또는 추정(estimated) 구분"
    },
    "transport": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "가까운 역이나 교통 거점"
        },
        "travel": {
          "$ref": "#/$defs/travel"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "location": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250,
          "description": "호텔 위치(실제 주소가 확인된 경우)"
        },
        "coordinates": {
          "$ref": "#/$defs/coords"
        },
        "nearestTransport": {
          "$ref": "#/$defs/transport"
        },
        "transportSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 700,
          "description": "주요 교통 접근성"
        },
        "areaSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 700,
          "description": "여행 동선과의 관련성"
        }
      },
      "additionalProperties": false,
      "description": "위치 정보는 확인된 값만 제공하고 빈 값은 생성하지 않습니다."
    },
    "ratingSource": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "평점을 게시한 서비스"
        },
        "maxScore": {
          "type": "number",
          "const": 10
        },
        "sourceUrl": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$",
          "format": "uri",
          "description": "실제 웹사이트의 절대 URL"
        },
        "checkedAt": {
          "type": "string",
          "format": "date",
          "description": "정보를 확인한 날짜(YYYY-MM-DD)"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "maxScore",
        "sourceUrl",
        "checkedAt"
      ]
    },
    "hotelIdentity": {
      "type": "object",
      "properties": {
        "nameKo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "호텔 한글명"
        },
        "nameEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "영문명/현지명"
        },
        "country": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "국가명"
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "도시명"
        },
        "area": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "숙박 위치 권역"
        },
        "grade": {
          "type": "string",
          "minLength": 3,
          "maxLength": 4,
          "description": "예: 5성급. 공식 분류 확인 시에만 기재.",
          "pattern": "^[1-5]성급$"
        },
        "guestRating": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4,
          "description": "0.0~10.0 범위의 평점. 출처 필수.",
          "pattern": "^(?:10(?:\\.0)?|[0-9](?:\\.[0-9])?)$"
        },
        "reviewCount": {
          "type": "integer",
          "minimum": 0
        },
        "ratingSource": {
          "$ref": "#/$defs/ratingSource"
        },
        "coordinates": {
          "$ref": "#/$defs/coords"
        }
      },
      "additionalProperties": false,
      "required": [
        "nameKo",
        "city",
        "country"
      ],
      "description": "기존 hotel-review-v1.1의 호텔 기본 필드명 재사용",
      "allOf": [
        {
          "if": {
            "required": [
              "guestRating"
            ]
          },
          "then": {
            "required": [
              "ratingSource"
            ]
          }
        }
      ]
    },
    "quickPick": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 2,
          "maxLength": 55,
          "description": "한눈에 보기 카드의 한 줄 추천 유형"
        },
        "summary": {
          "type": "string",
          "minLength": 12,
          "maxLength": 320,
          "description": "호텔마다 구별되는 추천 이유"
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "summary"
      ]
    },
    "editorial": {
      "type": "object",
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 5,
          "maxLength": 130,
          "description": "매거진형 아티클 제목"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 45,
            "description": "키워드"
          },
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 30,
            "maxLength": 1400,
            "description": "평범한 대화가 아니라 여행 매거진처럼 자연스럽게 작성하는 본문 문단"
          },
          "minItems": 3,
          "maxItems": 4
        },
        "whyRecommend": {
          "type": "string",
          "minLength": 20,
          "maxLength": 800,
          "description": "추천하는 이유: 구체적인 여행 상황과 연결"
        },
        "checkBeforeBooking": {
          "type": "string",
          "minLength": 20,
          "maxLength": 800,
          "description": "체크할 점: 예약 전에 고려할 실제 조건"
        }
      },
      "additionalProperties": false,
      "required": [
        "headline",
        "keywords",
        "paragraphs",
        "whyRecommend",
        "checkBeforeBooking"
      ],
      "description": "호텔별로 다른 매거진 서술을 갖는 섹션, analysis 앞에 렌더링"
    },
    "analysisItem": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "요약 제목"
        },
        "text": {
          "type": "string",
          "minLength": 12,
          "maxLength": 1000,
          "description": "근거 기반 설명"
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "text"
      ]
    },
    "analysis": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000,
          "description": "아티클 반복이 아닌 객관적 핵심 요약"
        },
        "pros": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/analysisItem"
          },
          "minItems": 2,
          "maxItems": 4
        },
        "cons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/analysisItem"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "reviewInsight": {
          "type": "string",
          "minLength": 20,
          "maxLength": 900,
          "description": "이용 후기에서 반복 확인되는 경향. 사실 확인 후 작성"
        }
      },
      "additionalProperties": false,
      "required": [
        "summary",
        "pros",
        "cons"
      ],
      "description": "에디토리얼 아래의 정보형 분석 카드"
    },
    "recommendation": {
      "type": "object",
      "properties": {
        "bestFor": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 140,
            "description": "추천 여행 스타일"
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "notIdealFor": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 140,
            "description": "아쉬울 수 있는 여행 조건"
          },
          "minItems": 0,
          "maxItems": 3,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "bestFor"
      ]
    },
    "booking": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$",
          "format": "uri",
          "description": "실제 웹사이트의 절대 URL"
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "예약 서비스명"
        },
        "tip": {
          "type": "string",
          "minLength": 5,
          "maxLength": 600,
          "description": "객실·조식·취소 조건 등 주의점"
        }
      },
      "additionalProperties": false,
      "required": [
        "url",
        "platform"
      ],
      "description": "예약 URL이 검증된 경우에만 설정. UI는 rel=sponsored 적용"
    },
    "hotelEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "영문 소문자·숫자·하이픈으로 구성된 식별자",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "hotel": {
          "$ref": "#/$defs/hotelIdentity"
        },
        "quickPick": {
          "$ref": "#/$defs/quickPick"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "editorial": {
          "$ref": "#/$defs/editorial"
        },
        "analysis": {
          "$ref": "#/$defs/analysis"
        },
        "recommendation": {
          "$ref": "#/$defs/recommendation"
        },
        "booking": {
          "$ref": "#/$defs/booking"
        },
        "hotelReviewSlug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
