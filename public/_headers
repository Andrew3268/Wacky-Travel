/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Permitted-Cross-Domain-Policies: none
  X-DNS-Prefetch-Control: on
  Content-Security-Policy: default-src 'self' https:; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https:; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https:; frame-src 'self' https:; media-src 'self' https:; worker-src 'self' blob:; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=31536000, immutable

/robots.txt
  Cache-Control: public, max-age=3600, s-maxage=3600
  X-Robots-Tag: noindex

/sitemap.xml
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
  X-Robots-Tag: noindex

/api/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

/add.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

/edit.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

/search/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, follow, noarchive

/hotel-promotions/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

/travel-by-mood/ocean-rest/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

/agoda-card-discount/*
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Static pages on the default Pages host must never be indexed.
# The custom domain remains the canonical origin in every HTML document.
https://wacky-travel.pages.dev/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

# Preview deployment subdomains are also excluded from search results.
https://:version.wacky-travel.pages.dev/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

# HSTS for the connected production domain. Static responses do not pass through Functions.
https://bestayable.com/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Language: ko-KR
