{
  "name": "wacky-travel-ssr",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev ./public --compatibility-date=2026-03-25",
    "deploy": "wrangler pages deploy ./public --project-name=wacky-travel",
    "d1:exec": "wrangler d1 execute wacky-travel-db --file=./db/schema.sql",
    "d1:seed": "wrangler d1 execute wacky-travel-db --file=./db/seed.sql",
    "d1:migrate:travel": "wrangler d1 execute wacky-travel-db --file=./db/migrations/001_travel_affiliate_schema.sql",
    "d1:migrate:travel-settings": "wrangler d1 execute wacky-travel-db --file=./db/migrations/002_travel_exposure_settings.sql",
    "d1:migrate:brand": "wrangler d1 execute wacky-travel-db --file=./db/migrations/011_be_stayable_brand.sql",
    "d1:migrate:brand:remote": "wrangler d1 execute wacky-travel-db --remote --file=./db/migrations/011_be_stayable_brand.sql",
    "check:index-inline": "node ./tools/index-inline-check.js",
    "d1:migrate:regions": "wrangler d1 execute wacky-travel-db --file=./db/migrations/006_regions.sql",
    "d1:migrate:guest-rating": "wrangler d1 execute wacky-travel-db --file=./db/migrations/007_hotel_guest_rating.sql",
    "d1:migrate:recommendation-categories": "wrangler d1 execute wacky-travel-db --file=./db/migrations/008_recommendation_categories.sql",
    "d1:migrate:recommendation-categories-global": "wrangler d1 execute wacky-travel-db --file=./db/migrations/009_global_recommendation_categories.sql",
    "d1:migrate:hotel-curation": "wrangler d1 execute wacky-travel-db --file=./db/migrations/010_hotel_curation_items.sql",
    "seo:routes": "node ./tools/generate-static-routes.mjs",
    "seo:audit": "node ./tools/seo-audit.mjs",
    "check:syntax": "node ./tools/syntax-check.mjs",
    "check": "npm run seo:normalize && npm run routes:functions && npm run seo:routes && npm run seo:audit && npm run check:index-inline && npm run check:static-destinations && npm run check:syntax",
    "predeploy": "npm run check",
    "d1:migrate:recommendation-category-names": "wrangler d1 execute wacky-travel-db --file=./db/migrations/012_recommendation_category_names.sql",
    "d1:migrate:recommendation-category-names:remote": "wrangler d1 execute wacky-travel-db --remote --file=./db/migrations/012_recommendation_category_names.sql",
    "check:static-destinations": "node ./tools/check-static-destination-pages.mjs",
    "seo:normalize": "node ./tools/normalize-static-seo-urls.mjs",
    "routes:functions": "node ./tools/generate-function-routes.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.77.0"
  }
}
